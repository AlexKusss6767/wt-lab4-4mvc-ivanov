@model List<wt_lab4_4mvc_ivanov.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог товаров</h1>
            <p class="text-muted">Система управления товарами</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Добавить товар</a>
    </div>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 align-self-start">ID: @product.Id</span>
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted">@product.Category</p>
                        <p class="fs-4 fw-bold">@product.Price руб.</p>
                        @if (product.IsAvailable)
                        {
                            <span class="badge bg-success mb-2">В наличии</span>
                        }
                        else
                        {
                            <span class="badge bg-danger mb-2">Нет в наличии</span>
                        }
                        <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary">Подробнее</a>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-secondary">Редактировать</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>