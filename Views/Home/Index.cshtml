@{
    ViewData["Title"] = "Главная";
}

<div class="container py-5">
    <div class="p-5 mb-4 rounded-4 text-white shadow" 
         style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold">
                <i class="bi bi-shop-window"></i> Добро пожаловать в WT-4 Store
            </h1>
            <p class="col-md-8 fs-5">
                Система управления товарами на ASP.NET Core MVC. 
                Просматривайте каталог, добавляйте новые товары и редактируйте существующие.
            </p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg mt-2">
                <i class="bi bi-box-seam"></i> Перейти в каталог
            </a>
        </div>
    </div>

    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                <i class="bi bi-list-check fs-1 text-primary"></i>
                <h5 class="mt-3">Каталог</h5>
                <p class="text-muted">Просмотр всех товаров магазина</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                <i class="bi bi-plus-circle fs-1 text-success"></i>
                <h5 class="mt-3">Добавление</h5>
                <p class="text-muted">Быстрое добавление новых товаров</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                <i class="bi bi-pencil-square fs-1 text-warning"></i>
                <h5 class="mt-3">Редактирование</h5>
                <p class="text-muted">Изменение данных существующих товаров</p>
            </div>
        </div>
    </div>
</div>